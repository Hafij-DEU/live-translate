<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero: gradient header with status and the main action. -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hero_bg"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="20dp"
            android:paddingEnd="22dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/logo_bg"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_glyph" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/app_name"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tagline"
                        android:textColor="#E0FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/pill_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/start"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_white"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="10dp"
                android:drawableTint="@color/brand"
                android:elevation="4dp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="24dp"
                android:paddingEnd="48dp"
                android:stateListAnimator="@null"
                android:text="@string/start_bubble"
                android:textAllCaps="false"
                android:textColor="@color/brand"
                android:textSize="16sp" />

            <Button
                android:id="@+id/stop"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_glass"
                android:drawableStart="@drawable/ic_stop"
                android:drawablePadding="10dp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="24dp"
                android:paddingEnd="48dp"
                android:stateListAnimator="@null"
                android:text="@string/stop_bubble"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Languages -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/CardIcon"
                        android:backgroundTint="@color/c_violet"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_globe" />

                    <TextView style="@style/CardTitle" android:text="@string/card_languages" />
                </LinearLayout>

                <TextView style="@style/Label" android:text="@string/label_source" />

                <Spinner android:id="@+id/source" style="@style/Picker" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Label"
                        android:layout_gravity="start|bottom"
                        android:text="@string/label_target" />

                    <ImageButton
                        android:id="@+id/swap"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="24dp"
                        android:background="@drawable/swap_bg"
                        android:contentDescription="@string/swap"
                        android:elevation="2dp"
                        android:src="@drawable/ic_swap" />
                </FrameLayout>

                <Spinner android:id="@+id/target" style="@style/Picker" />
            </LinearLayout>

            <!-- Engine -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/CardIcon"
                        android:backgroundTint="@color/c_amber"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bolt" />

                    <TextView style="@style/CardTitle" android:text="@string/label_engine" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/engine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="-6dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/engine_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/key_link"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/field_bg"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/accent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- OCR script -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/CardIcon"
                        android:backgroundTint="@color/c_teal"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_text" />

                    <TextView style="@style/CardTitle" android:text="@string/label_script" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/script"
                    style="@style/Picker"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

            <!-- Tiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/packs"
                    style="@style/Tile"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/tile_packs">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/tile_icon_bg"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_download" />

                    <TextView style="@style/TileTitle" android:text="@string/packs_title" />

                    <TextView
                        android:id="@+id/packs_count"
                        style="@style/TileText"
                        android:text="@string/packs_tile" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settings"
                    style="@style/Tile"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/tile_about">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/tile_icon_bg"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_settings" />

                    <TextView style="@style/TileTitle" android:text="@string/settings" />

                    <TextView style="@style/TileText" android:text="@string/settings_tile" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/help"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
