<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="@color/grad_mid"
                android:endColor="@color/grad_end"
                android:startColor="@color/grad_start" />
            <corners android:bottomLeftRadius="36dp" android:bottomRightRadius="36dp" />
        </shape>
    </item>
    <!-- Soft light blobs for depth. -->
    <item android:width="220dp" android:height="220dp" android:gravity="top|end" android:top="-80dp" android:end="-70dp">
        <shape android:shape="oval">
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>
    <item android:width="140dp" android:height="140dp" android:gravity="bottom|start" android:bottom="-40dp" android:start="-30dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
